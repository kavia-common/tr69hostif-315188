{"is_source_file": true, "format": "C header file", "description": "This file defines the interface for rbusFilter, a component used for creating, combining, and applying filters on values in the rbus system. It includes typedefs, enums, and function declarations for initializing relation and logic filters, applying filters to values, managing ownership, and accessing filter properties. It serves as part of a larger system related to event filtering and evaluation based on configurable expressions.", "external_files": ["rbus_value.h"], "external_methods": ["rbusValue_t"], "published": ["rbusFilter_t", "rbusFilter_InitRelation", "rbusFilter_InitLogic", "rbusFilter_Retain", "rbusFilter_Release", "rbusFilter_Apply", "rbusFilter_GetType", "rbusFilter_GetRelationOperator", "rbusFilter_GetRelationValue", "rbusFilter_GetLogicOperator", "rbusFilter_GetLogicLeft", "rbusFilter_GetLogicRight", "rbusFilter_Compare", "rbusFilter_fwrite"], "classes": [], "methods": [{"name": "rbusFilter_InitRelation", "description": "Creates and initializes a relation filter based on a specified operator and comparison value."}, {"name": "rbusFilter_InitLogic", "description": "Creates and initializes a logic filter combining one or two filters with a logical operator."}, {"name": "rbusFilter_Retain", "description": "Increases the reference count of a filter, enabling shared ownership."}, {"name": "rbusFilter_Release", "description": "Decreases the reference count of a filter and releases resources when count reaches zero."}, {"name": "rbusFilter_Apply", "description": "Evaluates a filter against a given value, returning true or false."}, {"name": "rbusFilter_GetType", "description": "Returns the expression type of the filter (relation or logic)."}, {"name": "rbusFilter_GetRelationOperator", "description": "Returns the relation operator used in a relation filter."}, {"name": "rbusFilter_GetRelationValue", "description": "Retrieves the value used in a relation filter."}, {"name": "rbusFilter_GetLogicOperator", "description": "Returns the logical operator used in a logic filter."}, {"name": "rbusFilter_GetLogicLeft", "description": "Returns the left filter in a logic filter."}, {"name": "rbusFilter_GetLogicRight", "description": "Returns the right filter in a logic filter."}, {"name": "rbusFilter_Compare", "description": "Compares two filters for equality."}, {"name": "rbusFilter_fwrite", "description": "Outputs a textual representation of a filter to a file stream for debugging."}], "calls": ["rbusFilter_Release", "rbusFilter_Retain", "rbusFilter_Apply", "rbusFilter_GetType", "rbusFilter_GetRelationOperator", "rbusFilter_GetRelationValue", "rbusFilter_GetLogicOperator", "rbusFilter_GetLogicLeft", "rbusFilter_GetLogicRight", "rbusFilter_Compare", "rbusFilter_fwrite"], "search-terms": ["rbusFilter", "relation filter", "logic filter", "filter expression", "filter apply", "filter comparison", "rbus_value", "rbusFilter_InitRelation", "rbusFilter_InitLogic"], "state": 2, "file_id": 328, "knowledge_revision": 1062, "git_revision": "db913d7e78c379f68c2743350abf00b185314946", "ctags": [{"_type": "tag", "name": "RBUS_FILTER_EXPRESSION_LOGIC", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/include/rbus_filter.h", "pattern": "/^    RBUS_FILTER_EXPRESSION_LOGIC,$/", "language": "C++", "kind": "enumerator", "scope": "__anondaa78e5b0303", "scopeKind": "enum"}, {"_type": "tag", "name": "RBUS_FILTER_EXPRESSION_RELATION", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/include/rbus_filter.h", "pattern": "/^    RBUS_FILTER_EXPRESSION_RELATION,$/", "language": "C++", "kind": "enumerator", "scope": "__anondaa78e5b0303", "scopeKind": "enum"}, {"_type": "tag", "name": "RBUS_FILTER_H", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/include/rbus_filter.h", "pattern": "/^#define RBUS_FILTER_H$/", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "RBU