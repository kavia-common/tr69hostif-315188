{"is_source_file": true, "format": "C header file", "description": "This file defines the interface for rbus filter functionality, including data structures, initialization functions for relation and logic filters, reference counting, application of filters to values, and accessors for internal members. It provides the basis for constructing and evaluating complex boolean expressions used as filters on event values within the rbus system.", "external_files": ["rbus_value.h"], "external_methods": [], "published": ["rbusFilter_InitRelation", "rbusFilter_InitLogic", "rbusFilter_Retain", "rbusFilter_Release", "rbusFilter_Apply", "rbusFilter_GetType", "rbusFilter_GetRelationOperator", "rbusFilter_GetRelationValue", "rbusFilter_GetLogicOperator", "rbusFilter_GetLogicLeft", "rbusFilter_GetLogicRight", "rbusFilter_Compare", "rbusFilter_fwrite"], "classes": [], "methods": [{"name": "rbusFilter_InitRelation", "description": "Initializes a relation filter with a specific operator and value."}, {"name": "rbusFilter_InitLogic", "description": "Initializes a logic filter combining one or two sub-filters with a logical operator."}, {"name": "rbusFilter_Retain", "description": "Increments reference count for shared ownership of a filter."}, {"name": "rbusFilter_Release", "description": "Decrements reference count and releases the filter if no longer used."}, {"name": "rbusFilter_Apply", "description": "Applies the filter to a given value, returning true if the filter conditions are satisfied."}, {"name": "rbusFilter_GetType", "description": "Returns the expression type (relation or logic) of the filter."}, {"name": "rbusFilter_GetRelationOperator", "description": "Returns the relation operator used in a relation filter."}, {"name": "rbusFilter_GetRelationValue", "description": "Returns the comparison value in a relation filter."}, {"name": "rbusFilter_GetLogicOperator", "description": "Returns the logical operator used in a logic filter."}, {"name": "rbusFilter_GetLogicLeft", "desc