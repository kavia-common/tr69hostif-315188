{"is_source_file": true, "format": "C/C++ header", "description": "This file defines the public API for managing and retrieving statistics related to the MoCA Interface in a device via TR-069 protocol. It includes class declarations, constants, and documentation for throughput and error counters on the interface.", "external_files": ["hostIf_main.h", "hostIf_tr69ReqHandler.h", "hostIf_utils.h", "Device_MoCA_Interface.h"], "external_methods": ["MoCAInterfaceStats::getInstance()", "MoCAInterfaceStats::get_BytesSent()", "MoCAInterfaceStats::get_BytesReceived()", "MoCAInterfaceStats::get_PacketsSent()", "MoCAInterfaceStats::get_PacketsReceived()", "MoCAInterfaceStats::get_ErrorsSent()", "MoCAInterfaceStats::get_ErrorsReceived()", "MoCAInterfaceStats::get_UnicastPacketsSent()", "MoCAInterfaceStats::get_UnicastPacketsReceived()", "MoCAInterfaceStats::get_DiscardPacketsSent()", "MoCAInterfaceStats::get_DiscardPacketsReceived()", "MoCAInterfaceStats::get_MulticastPacketsSent()", "MoCAInterfaceStats::get_MulticastPacketsReceived()", "MoCAInterfaceStats::get_BroadcastPacketsSent()", "MoCAInterfaceStats::get_BroadcastPacketsReceived()", "MoCAInterfaceStats::get_UnknownProtoPacketsReceived()"], "published": ["MoCAInterfaceStats"], "classes": [{"name": "MoCAInterfaceStats", "description": "A singleton class that provides throughput and error statistics for the MoCA interface, including methods to retrieve counters for bytes sent/received, packets sent/received, and various error counts."}], "methods": [{"name": "get_BytesSent", "description": "Retrieves the total number of bytes transmitted out of the MoCA interface, including framing characters, updating the Device.MoCA.Interface.{i}.Stats.BytesSent parameter."}, {"name": "get_BytesReceived", "description": "Retrieves the total number of bytes received on the MoCA interface, including framing characters, updating the Device.MoCA.Interface.{i}.Stats.BytesReceived parameter."}, {"name": "get_PacketsSent", "description": "Retrieve