en topic."}, {"name": "rtRoutingTree_RemoveRoute", "description": "Removes a route and all its associated topics from the tree."}, {"name": "rtRoutingTree_RemoveTopic", "description": "Removes a specified topic from the tree."}, {"name": "rtRoutingTree_ResolvePartialPath", "description": "Resolves a partial path to a list of topics that can fully resolve the path."}, {"name": "rtRoutingTree_LogStats", "description": "Logs statistical information about the routing tree."}, {"name": "rtRoutingTree_LogTopicTree", "description": "Logs the hierarchical structure of the topic tree."}, {"name": "rtRoutingTree_LogRouteList", "description": "Logs all routes configured in the tree."}], "calls": ["rtRoutingTree_Create", "rtRoutingTree_Destroy", "rtRoutingTree_AddTopicRoute", "rtRoutingTree_GetRouteTopics", "rtRoutingTree_GetTopicRoutes", "rtRoutingTree_RemoveRoute", "rtRoutingTree_RemoveTopic", "rtRoutingTree_ResolvePartialPath", "rtRoutingTree_LogStats", "rtRoutingTree_LogTopicTree", "rtRoutingTree_LogRouteList"], "search-terms": ["rtRoutingTree", "route", "topic", "wildcard", "partialPath", "TR-069", "pubsub", "rbus", "routeList", "fullName"], "state": 2, "file_id": 289, "knowledge_revision": 1028, "git_revision": "db913d7e78c379f68c2743350abf00b185314946", "ctags": [{"_type": "tag", "name": "__RT_ROUTETREE_H__", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/src/rtmessage/rtRoutingTree.h", "pattern": "/^#define __RT_ROUTETREE_H__$/", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "_rtRoutingTree", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/src/rtmessage/rtRoutingTree.h", "pattern": "/^typedef struct _rtRoutingTree$/", "language": "C++", "kind": "struct"}, {"_type": "tag", "name": "childList", "path": "/home/kavia/workspace/code-generation/tr69hostif-315188/src/unittest/stubs/rbus/src/rtmessage/rtRoutingTree.h", "pattern": "/^    rtList childList;       \\/*list of rtTreeTo